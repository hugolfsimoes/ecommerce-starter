generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// CHECK constraints (marked "CHECK" below) live only in the init migration SQL,
// because Prisma cannot represent them. See "Constraints no banco" in CLAUDE.md.

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  position Int       @default(0)
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  active      Boolean          @default(true)
  attributes  Json?
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, active])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String      @unique
  name        String
  priceCents  Int // CHECK: >= 0
  stock       Int         @default(0) // CHECK: >= 0 (last guard against overselling)
  weightGrams Int?
  active      Boolean     @default(true)
  orderItems  OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId, position])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  number          Int         @unique @default(autoincrement()) // human-readable order number; sequence starts at 1001 (set in init migration)
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail   String
  customerName    String
  status          OrderStatus @default(PENDING)
  subtotalCents   Int // CHECK: >= 0
  shippingCents   Int         @default(0) // CHECK: >= 0
  discountCents   Int         @default(0) // CHECK: >= 0
  totalCents      Int // CHECK: >= 0
  shippingMethod  String?
  shippingAddress Json?
  couponCode      String?
  paymentProvider String?
  paymentId       String?     @unique
  paidAt          DateTime?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([customerEmail])
  @@index([status, createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  variantName    String
  sku            String
  unitPriceCents Int // CHECK: >= 0
  quantity       Int // CHECK: > 0

  @@index([orderId])
  @@index([variantId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int? // CHECK: BETWEEN 1 AND 100; at most one of percentOff / amountOffCents
  amountOffCents Int? // CHECK: > 0; at most one of percentOff / amountOffCents
  freeShipping   Boolean   @default(false) // CHECK: at least one benefit (percentOff, amountOffCents or freeShipping)
  minOrderCents  Int? // CHECK: >= 0
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}
